---
import { blankWidthEm, splitStem } from '../domain/blank';
import { plainText, parseZhuyin } from '../domain/zhuyin';
import type { FillBlankQuestion } from '../domain/schema';
import Explanation from './Explanation.astro';
import RichText from './RichText.astro';

interface Props {
  /** 試卷內的連續題號 */
  number: number;
  question: FillBlankQuestion;
}

const { number, question } = Astro.props;
const parts = splitStem(question.stem);
---

<div class="question question-fill-blank" data-question-type="fill-blank">
  <p class="stem">
    {/* 空格與前後文字之間不留空白字元，答案卷切換時底線位置才不會動 */}
    <span class="number">{number}.</span>
    {
      parts.map((part, i) => (
        <>
          <RichText text={part} />
          {i < question.answer.length && (
            <span class="blank" style={`--blank-width: ${blankWidthEm(plainText(parseZhuyin(question.answer[i]!).segments))}em`}><span class="blank-answer"><RichText text={question.answer[i]!} /></span></span>
          )}
        </>
      ))
    }
  </p>
  <Explanation text={question.explanation} />
</div>
