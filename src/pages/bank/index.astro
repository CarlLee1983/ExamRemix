---
// 題庫瀏覽頁：單一清單列出題庫所有題目（依 ID 排序），每題收合，展開後以答案卷版面顯示（答案與解析都可見）。
// 篩選在前端以 data 屬性進行，條件可寫進網址（?subject=數學），頁面仍是純靜態、唯讀；發現問題時開 GitHub issue，在本機由 agent 處理。
import BankItem from '../../components/BankItem.astro';
import Icon from '../../components/Icon.astro';
import { paperTitlesByQuestion } from '../../domain/paper-usage';
import { SUBJECTS } from '../../domain/schema';
import { NO_UNIT_LABEL } from '../../domain/unit';
import { TYPE_LABELS } from '../../domain/type-labels';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadChecked } from '../../lib/load-bank.ts';
import '../../styles/paper.css';
import '../../styles/bank.css';

const { papers, entries } = await loadChecked();

// entries 已依 ID 排序；用於哪些試卷在建置期算好
const usage = paperTitlesByQuestion(papers);

// 沒有單元的題目以 NO_UNIT_LABEL 作為篩選值（與列出題目指令共用）

const present = <T,>(pick: (e: (typeof entries)[number]) => T) => new Set(entries.map(pick));
const subjects = SUBJECTS.filter((s) => present((e) => e.question.subject).has(s));
const grades = [...present((e) => e.question.grade)].sort((a, b) => a - b);
const units = [...present((e) => e.question.unit)].filter((u): u is string => u !== undefined).sort((a, b) => a.localeCompare(b, 'zh-Hant'));
const hasNoUnit = entries.some((e) => e.question.unit === undefined);
const types = (Object.keys(TYPE_LABELS) as (keyof typeof TYPE_LABELS)[]).filter((t) => present((e) => e.question.type).has(t));

const filters = [
  { key: 'subject', label: '科目', options: subjects.map((s) => ({ value: s, text: s })) },
  { key: 'grade', label: '年級', options: grades.map((g) => ({ value: String(g), text: `${g} 年級` })) },
  {
    key: 'unit',
    label: '單元',
    options: [...units.map((u) => ({ value: u, text: u })), ...(hasNoUnit ? [{ value: NO_UNIT_LABEL, text: '（無單元）' }] : [])],
  },
  { key: 'type', label: '題型', options: types.map((t) => ({ value: t, text: TYPE_LABELS[t] })) },
];
---

<SiteLayout title="題庫瀏覽 - ExamRemix" current="bank" mode="answer">
  <h1 class="display">題庫瀏覽</h1>
  <p class="lede">題目預設可用；發現問題時開 GitHub issue，寫上題目 ID 與問題描述。</p>
  {/* 篩選要 JS 才能運作，沒有 JS 時整列隱藏，所有題目照常列出 */}
  <form class="filters card" id="filters" hidden>
    {
      filters.map((filter) => (
        <label class="form-field">
          {filter.label}
          <select class="select" name={filter.key}>
            <option value="">全部</option>
            {filter.options.map((option) => <option value={option.value}>{option.text}</option>)}
          </select>
        </label>
      ))
    }
    <button type="button" class="btn quiet sm" id="clear-filters" hidden><Icon name="x" />清除條件</button>
    <span class="muted" id="count" role="status"></span>
  </form>
  <div class="card bank-list" id="items">
    {entries.map(({ id, question }) => <BankItem id={id} question={question} usedIn={usage.get(id) ?? []} />)}
  </div>
  {/* 複製 ID 的結果，給讀屏軟體用；畫面上看不到 */}
  <p class="sr-only" id="announce" role="status"></p>
  <script is:inline>
    // 篩選條件：各 <select> 的值，空字串是全部；條件之間是 AND。條件與網址的查詢字串雙向同步（用 replaceState，不留歷史）。
    // 需要 JS 的控制項（篩選列、複製鈕）預設 hidden，在這裡才顯示。
    const form = document.getElementById('filters');
    const items = [...document.querySelectorAll('.bank-item')];
    const count = document.getElementById('count');
    const clear = document.getElementById('clear-filters');
    const selects = [...form.querySelectorAll('select')];
    form.hidden = false;
    for (const control of document.querySelectorAll('.copy-id')) control.hidden = false;
    form.addEventListener('submit', (event) => event.preventDefault());

    const params = new URLSearchParams(location.search);
    for (const select of selects) {
      const value = params.get(select.name);
      // 網址裡不認得的值當作全部
      if (value !== null && [...select.options].some((o) => o.value === value)) select.value = value;
    }

    function apply() {
      let shown = 0;
      for (const item of items) {
        const match = selects.every((s) => s.value === '' || item.dataset[s.name] === s.value);
        item.hidden = !match;
        if (match) shown += 1;
      }
      // 有條件的下拉轉藍底，一眼看出哪些條件正在生效
      for (const s of selects) s.classList.toggle('active', s.value !== '');
      clear.hidden = selects.every((s) => s.value === '');
      count.textContent = `共 ${items.length} 題，顯示 ${shown} 題`;
    }

    function syncUrl() {
      const query = new URLSearchParams();
      for (const s of selects) if (s.value !== '') query.set(s.name, s.value);
      const text = query.toString();
      history.replaceState(null, '', text === '' ? location.pathname : `?${text}`);
    }

    form.addEventListener('change', () => {
      apply();
      syncUrl();
    });
    clear.addEventListener('click', () => {
      for (const s of selects) s.value = '';
      apply();
      syncUrl();
      // 清除鈕在這之後會隱藏，焦點移到第一個篩選框，才不會掉回頁面頂端
      selects[0].focus();
    });

    // 複製後在按鈕上回饋，並寫進讀屏用的狀態區。成功：短暫顯示「已複製」再還原；
    // 失敗（剪貼簿不可用或被拒絕）：訊息留到下次點擊，並選取對應文字讓人自己複製
    const announce = document.getElementById('announce');
    const resetTimers = new WeakMap();
    async function copyId(button) {
      const item = button.closest('.bank-item');
      const id = item.dataset.id;
      const label = button.querySelector('span');
      label.dataset.original ??= label.textContent;
      clearTimeout(resetTimers.get(button));
      button.classList.remove('done');
      try {
        await navigator.clipboard.writeText(id);
        label.textContent = '已複製';
        button.classList.add('done');
        announce.textContent = `已複製 ${id}`;
        resetTimers.set(
          button,
          setTimeout(() => {
            label.textContent = label.dataset.original;
            button.classList.remove('done');
          }, 1800),
        );
      } catch {
        label.textContent = '無法複製，請自行選取';
        announce.textContent = `無法複製 ${id}，已選取 ID，請自行複製`;
        getSelection().selectAllChildren(item.querySelector('.question-id'));
      }
    }
    document.addEventListener('click', (event) => {
      const button = event.target.closest('.copy-id');
      if (button) copyId(button);
    });

    apply();
  </script>
</SiteLayout>
