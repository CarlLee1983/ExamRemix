---
import Question from '../../components/Question.astro';
import { doubtedNumbers, firstNumbers } from '../../domain/paper-numbers.ts';
import { loadChecked } from '../../lib/load-bank.ts';
import '../../styles/paper.css';

export async function getStaticPaths() {
  // 載入時已跑過跨檔檢查：引用的題目 ID 一定存在且已確認；引用到有疑點的題目只是警告，照常產生頁面
  const { papers, questions } = await loadChecked();

  return papers.map((paper) => ({
    params: { paper: paper.id },
    props: {
      paper: paper.data,
      sections: paper.data.sections.map((section) => ({
        ...section,
        questions: section.questions.map((id) => questions.get(id)!),
      })),
    },
  }));
}

const { paper, sections } = Astro.props;

const numbers = firstNumbers(sections);
// 有疑點的題目在這份試卷裡的題號，給螢幕上的頂端提示用
const doubted = doubtedNumbers(sections);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{paper.title}</title>
  </head>
  <body>
    <button type="button" class="mode-toggle" id="mode-toggle" aria-pressed="false" hidden>顯示答案卷</button>
    {
      doubted.length > 0 && (
        <p class="doubt-notice" role="note">
          這份試卷有 {doubted.length} 題有疑點：{doubted.map((n) => `第 ${n} 題`).join('、')}
        </p>
      )
    }
    <main class="paper">
      <header class="paper-head">
        <h1>{paper.title}</h1>
        <div class="fields">
          <div class="field name" data-field="name"><span class="label">姓名：</span><span class="line"></span></div>
          <div class="field date" data-field="date"><span class="label">日期：</span><span class="line"></span></div>
          <div class="field score" data-field="score"><span class="label">分數：</span><span class="line"></span></div>
        </div>
      </header>
      {
        sections.map((section, s) => (
          <section class="section">
            <h2 class="section-title">
              {section.title}
              {section.points !== undefined && <span class="points">（{section.points} 分）</span>}
            </h2>
            {section.questions.map((question, i) => (
              <Question number={numbers[s]! + i} question={question} />
            ))}
          </section>
        ))
      }
    </main>
    <script is:inline>
      // 載入時一律是試卷；狀態只存在頁面上，不保存。
      // CSS 只讀 html 的 data-mode；aria-pressed 是給輔助技術用的，標籤固定不變。
      // 切換鈕預設 hidden，沒有 JS 時維持隱藏，有 JS 才在此顯示。
      const toggle = document.getElementById('mode-toggle');
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        const answer = toggle.getAttribute('aria-pressed') !== 'true';
        toggle.setAttribute('aria-pressed', String(answer));
        document.documentElement.dataset.mode = answer ? 'answer' : 'paper';
      });
    </script>
  </body>
</html>
