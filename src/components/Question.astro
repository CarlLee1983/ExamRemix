---
// 「題型 → 元件」的唯一對應。新增題型要動的地方：
// schema.ts 的題型 schema 與 questionSchema 聯集、這個檔的 switch 與模板分支、新的題型元件、
// answer-space.ts 的預設作答空間（DEFAULT_SPACE）、type-labels.ts 的中文題型名稱、paper.css 的樣式、範例題庫與試卷、README 的題型表、schema 與 e2e 測試；
// 題型的選項或欄位帶圖片時，還要補 bank-check.ts 的 imageReferences，否則圖片存在性檢查會漏掉。
// 題型元件在題幹後放附圖（圖示標示題有自己的可定位圖框），並依 answerSpace(question) 留作答空間。漏接 switch 時 default 分支的型別檢查會報錯。
// 題型元件輸出任何題目文字都要經過 RichText，才能在文字上加注音。
// 唯一的例外是 CharToZhuyinQuestion 與 ZhuyinToCharQuestion 的題幹：題幹裡的每個注音標注都是考題，
// 由元件自己渲染成作答格，刻意不經過 RichText（交給它會把考題的注音直接顯示出來），不要「修」掉。
// 另一個例外是 VerticalCalcQuestion 的運算元與答案：schema 限定它們是純數字，元件要一個數字一格排進直式的格子，
// 不是一段文字，沒有注音或數學式可處理，所以直接輸出數字，也不要「修」掉。
import type { Question } from '../domain/schema';
import CharToZhuyinQuestion from './CharToZhuyinQuestion.astro';
import ChoiceQuestion from './ChoiceQuestion.astro';
import DiagramLabelQuestion from './DiagramLabelQuestion.astro';
import FillBlankQuestion from './FillBlankQuestion.astro';
import HorizontalCalcQuestion from './HorizontalCalcQuestion.astro';
import ImitateSentenceQuestion from './ImitateSentenceQuestion.astro';
import MakeSentenceQuestion from './MakeSentenceQuestion.astro';
import MultiSelectQuestion from './MultiSelectQuestion.astro';
import TableFillQuestion from './TableFillQuestion.astro';
import TrueFalseQuestion from './TrueFalseQuestion.astro';
import VerticalCalcQuestion from './VerticalCalcQuestion.astro';
import WordProblemQuestion from './WordProblemQuestion.astro';
import ZhuyinToCharQuestion from './ZhuyinToCharQuestion.astro';

interface Props {
  /** 試卷內的連續題號 */
  number: number;
  question: Question;
}

const { number, question } = Astro.props;

function unreachable(question: never): never {
  throw new Error(`未處理的題型：${JSON.stringify(question)}`);
}

// 只做窮舉檢查；模板依 question.type 收窄後渲染，各題型元件的 props 仍有型別檢查
switch (question.type) {
  case 'choice':
  case 'multi-select':
  case 'diagram-label':
  case 'table-fill':
  case 'true-false':
  case 'fill-blank':
  case 'char-to-zhuyin':
  case 'zhuyin-to-char':
  case 'make-sentence':
  case 'imitate-sentence':
  case 'horizontal-calc':
  case 'vertical-calc':
  case 'word-problem':
    break;
  default:
    unreachable(question);
}
---

{question.type === 'choice' && <ChoiceQuestion number={number} question={question} />}
{question.type === 'multi-select' && <MultiSelectQuestion number={number} question={question} />}
{question.type === 'diagram-label' && <DiagramLabelQuestion number={number} question={question} />}
{question.type === 'table-fill' && <TableFillQuestion number={number} question={question} />}
{question.type === 'true-false' && <TrueFalseQuestion number={number} question={question} />}
{question.type === 'fill-blank' && <FillBlankQuestion number={number} question={question} />}
{question.type === 'char-to-zhuyin' && <CharToZhuyinQuestion number={number} question={question} />}
{question.type === 'zhuyin-to-char' && <ZhuyinToCharQuestion number={number} question={question} />}
{question.type === 'make-sentence' && <MakeSentenceQuestion number={number} question={question} />}
{question.type === 'imitate-sentence' && <ImitateSentenceQuestion number={number} question={question} />}
{question.type === 'horizontal-calc' && <HorizontalCalcQuestion number={number} question={question} />}
{question.type === 'vertical-calc' && <VerticalCalcQuestion number={number} question={question} />}
{question.type === 'word-problem' && <WordProblemQuestion number={number} question={question} />}
