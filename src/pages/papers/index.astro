---
import { loadChecked } from '../../lib/load-bank.ts';
import '../../styles/site.css';

const { papers } = await loadChecked();
const rows = papers
  .map((paper) => ({
    id: paper.id,
    title: paper.data.title,
    subject: paper.data.subject,
    grade: paper.data.grade,
    count: paper.data.sections.reduce((sum, section) => sum + section.questions.length, 0),
  }))
  .sort((a, b) => (a.id < b.id ? -1 : 1));
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>試卷列表 - ExamRemix</title>
  </head>
  <body class="site-body">
    <main class="site">
      <nav class="site-nav"><a href="/">首頁</a><a href="/bank/">題庫瀏覽</a></nav>
      <h1>試卷列表</h1>
      <ul class="paper-list">
        {
          rows.map((row) => (
            <li>
              <a href={`/papers/${row.id}/`}>{row.title}</a>
              <span class="paper-meta">{row.subject}・{row.grade} 年級・{row.count} 題</span>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
