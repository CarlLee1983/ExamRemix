---
import Icon from '../components/Icon.astro';
import PaperRow from '../components/PaperRow.astro';
import { bankComposition } from '../domain/composition';
import { countDoubted, paperRows } from '../domain/paper-usage';
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadChecked } from '../lib/load-bank.ts';

const { papers, entries } = await loadChecked();
const doubted = countDoubted(entries);
const rows = paperRows(papers);
const composition = bankComposition(entries);
---

<SiteLayout title="ExamRemix" current="home">
  <section class="hero" slot="hero">
    <div class="hero-in">
      <div class="greet">
        {/* 日期要在瀏覽器端產生（建置時間不等於瀏覽時間），沒有 JS 時不顯示 */}
        <p class="date" id="today" hidden></p>
        <h1 class="display">總覽</h1>
        <p class="sum">
          {doubted > 0 ? <><b>{doubted} 題</b>有疑點，</> : '題庫目前沒有疑點，'}<b>{rows.length} 份試卷</b>可以列印。
        </p>
      </div>
      <section class="card stat" aria-labelledby="doubt-title">
        <h2 id="doubt-title">
          {doubted > 0 ? <span class="stat-num pending-count">{doubted}</span> : <span class="stat-num all-clear">沒有疑點</span>}
          <span class="stat-label">有疑點的題目</span>
        </h2>
        {
          doubted > 0 ? (
            <a class="btn primary" href="/bank/?doubt=true">
              查看疑點<Icon name="chevron-right" />
            </a>
          ) : (
            <a class="btn secondary" href="/bank/">
              查看題庫<Icon name="chevron-right" />
            </a>
          )
        }
      </section>
      <section class="card stat" aria-labelledby="papers-stat-title">
        <h2 id="papers-stat-title">
          <span class="stat-num">{rows.length}</span>
          <span class="stat-label">份試卷可列印</span>
        </h2>
        <a class="btn secondary" href="#papers">看試卷</a>
      </section>
    </div>
  </section>
  <section class="block" id="papers" aria-labelledby="papers-title">
    <h2 class="block-head" id="papers-title">試卷</h2>
    <ul class="paper-list">{rows.map((row) => <PaperRow row={row} />)}</ul>
  </section>
  <section class="block card" id="composition" aria-labelledby="composition-title">
    <div class="block-head">
      <h2 id="composition-title">題庫組成</h2>
      <span class="muted">共 {entries.length} 題</span>
    </div>
    <div class="mix">
      {
        composition.map((c) => {
          const detail = c.types.map((t) => `${t.label} ${t.count}`);
          return (
            <div class={`mix-subject subj-${c.subject}`} data-subject={c.subject}>
              <div class="mix-head">
                <span class="chip subject">{c.subject}</span>
                <strong>{c.count} 題</strong>
              </div>
              <div class="mix-bar" role="img" aria-label={`${c.subject}：${detail.join('、')}`}>
                {c.types.map((t) => <span style={`flex: ${t.count}`} title={`${t.label} ${t.count} 題`}></span>)}
              </div>
              <div class="muted">{detail.join('・')}</div>
            </div>
          );
        })
      }
    </div>
  </section>
  <script is:inline>
    // 問候日期：例如「10 月 27 日　星期一」
    const today = document.getElementById('today');
    const now = new Date();
    today.textContent = `${now.getMonth() + 1} 月 ${now.getDate()} 日　${now.toLocaleDateString('zh-TW', { weekday: 'long' })}`;
    today.hidden = false;
  </script>
</SiteLayout>
