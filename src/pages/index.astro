---
import { loadChecked } from '../lib/load-bank.ts';

const { papers } = await loadChecked();
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <title>ExamRemix</title>
  </head>
  <body>
    <h1>試卷</h1>
    <ul>
      {
        papers.map((paper) => (
          <li><a href={`/papers/${paper.id}/`}>{paper.data.title}</a></li>
        ))
      }
    </ul>
  </body>
</html>
