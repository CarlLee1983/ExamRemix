---
import RichText from './RichText.astro';

// 作答行數見 domain/answer-space.ts；行高是 paper.css 的 --sentence-line-height。

interface Props {
  /** 作答行數 */
  lines: number;
  /** 答案卷時顯示在作答行上的範例句子 */
  answer: string;
}

const { answer, lines } = Astro.props;
---

<div class="sentence-lines" data-space={lines}>
  {Array.from({ length: lines }, () => <div class="sentence-line" />)}
  <p class="sentence-answer"><RichText text={answer} /></p>
</div>
