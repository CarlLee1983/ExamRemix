---
import type { ChoiceQuestion } from '../domain/schema';
import AnswerBracket from './AnswerBracket.astro';
import Explanation from './Explanation.astro';

interface Props {
  /** 試卷內的連續題號 */
  number: number;
  question: ChoiceQuestion;
}

const { number, question } = Astro.props;
---

<div class="question question-choice" data-question-type="choice">
  <p class="stem">
    {/* 括號、題號之間刻意不留空白字元：換行會變成多餘的空格，使題幹位置與括號寬度改變 */}
    <AnswerBracket answer={question.answer} /><span class="number">{number}.</span>
    {question.stem}
  </p>
  <ol class="options">
    {
      question.options.map((option, i) => (
        <li class="option">
          <span class="option-no">({i + 1})</span> {option}
        </li>
      ))
    }
  </ol>
  <Explanation text={question.explanation} />
</div>
