---
import { answerSpace } from '../domain/answer-space';
import { answerBlankWidthEm } from '../domain/blank';
import type { HorizontalCalcQuestion } from '../domain/schema';
import Explanation from './Explanation.astro';
import QuestionFigure from './QuestionFigure.astro';
import RichText from './RichText.astro';

// 計算區的行數見 domain/answer-space.ts；行高是 paper.css 的 --calc-line-height。

interface Props {
  /** 試卷內的連續題號 */
  number: number;
  question: HorizontalCalcQuestion;
}

const { number, question } = Astro.props;
const space = answerSpace(question);
const blankWidth = answerBlankWidthEm(question.answer);
---

<div class="question question-horizontal-calc" data-question-type="horizontal-calc">
  <p class="stem">
    {/* 算式、底線之間不留空白字元，答案卷切換時底線位置才不會動（理由同填空題） */}
    <span class="number">{number}.</span>
    <RichText text={question.stem} /><span class="blank" style={`--blank-width: ${blankWidth}em`}><span class="blank-answer"><RichText text={question.answer} /></span></span>
  </p>
  <QuestionFigure image={question.image} />
  <div class="calc-area" data-space={space} style={`--calc-lines: ${space}`}></div>
  <Explanation text={question.explanation} />
</div>
