---
import PaperRow from '../../components/PaperRow.astro';
import { paperRows } from '../../domain/paper-usage';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadChecked } from '../../lib/load-bank.ts';

const { papers } = await loadChecked();
const rows = paperRows(papers);
---

<SiteLayout title="試卷列表 - ExamRemix" current="papers">
  <h1 class="display">試卷列表</h1>
  <p class="lede">開啟試卷或答案卷，或直接列印。</p>
  <ul class="paper-list">{rows.map((row) => <PaperRow row={row} withGrade />)}</ul>
</SiteLayout>
