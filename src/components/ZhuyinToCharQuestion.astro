---
import { answerSpace } from '../domain/answer-space';
import type { ZhuyinToCharQuestion } from '../domain/schema';
import { parseZhuyin } from '../domain/zhuyin';
import AnswerSpace from './AnswerSpace.astro';
import Explanation from './Explanation.astro';
import QuestionFigure from './QuestionFigure.astro';

interface Props {
  /** 試卷內的連續題號 */
  number: number;
  question: ZhuyinToCharQuestion;
}

const { number, question } = Astro.props;
const space = answerSpace(question);
const { segments } = parseZhuyin(question.stem);
---

<div class="question question-zhuyin-to-char" data-question-type="zhuyin-to-char">
  <p class="stem">
    {/* 每個被考的字一個作答格，注音是格子上方的 ruby；格子之間不留空白字元 */}
    <span class="number">{number}.</span>
    {
      segments.map((segment) =>
        segment.kind === 'text'
          ? segment.text
          : segment.chars.map(({ char, zhuyin }) => (
              <ruby><span class="char-cell"><span class="cell-answer">{char}</span></span><rp>(</rp><rt>{zhuyin}</rt><rp>)</rp></ruby>
            )),
      )
    }
  </p>
  <QuestionFigure image={question.image} />
  <AnswerSpace lines={space} />
  <Explanation text={question.explanation} />
</div>
