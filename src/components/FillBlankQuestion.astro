---
import { questionLanguage } from '../domain/question-language';
import { answerSpace } from '../domain/answer-space';
import { answerBlankWidthEm, splitStem } from '../domain/blank';
import type { FillBlankQuestion } from '../domain/schema';
import AnswerSpace from './AnswerSpace.astro';
import Explanation from './Explanation.astro';
import QuestionFigure from './QuestionFigure.astro';
import RichText from './RichText.astro';

interface Props {
  /** 試卷內的連續題號 */
  number: number;
  question: FillBlankQuestion;
}

const { number, question } = Astro.props;
const space = answerSpace(question);
const parts = splitStem(question.stem);
const fourLine = question.writingGuide === 'four-line';
---

<div class:list={['question', 'question-fill-blank', { 'question-four-line': fourLine }]} data-question-type="fill-blank">
  <p class="stem">
    {/* 空格與前後文字之間不留空白字元，答案卷切換時底線位置才不會動 */}
    <span class="number" lang="zh-Hant-TW">{number}.</span>
    {
      parts.map((part, i) => (
        <>
          <RichText text={part} />
          {i < question.answer.length && (
            <span class:list={['blank', { 'blank-four-line': fourLine }]} style={`--blank-width: ${fourLine ? Math.max(2, question.answer[i]!.length * 1.75 + 0.25) : answerBlankWidthEm(question.answer[i]!, questionLanguage(question.subject))}em;${fourLine ? `--writing-font-cap: ${100 / (question.answer[i]!.length * 1.1)}cqw` : ''}`}>
              {fourLine && <span class="writing-guide" aria-hidden="true"><span></span><span></span><span></span><span></span></span>}
              <span class="blank-answer"><RichText text={question.answer[i]!} /></span>
            </span>
          )}
        </>
      ))
    }
  </p>
  <QuestionFigure image={question.image} />
  <AnswerSpace lines={space} />
  <Explanation text={question.explanation} />
</div>
